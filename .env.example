# Application
ENV=development
PORT=8080
APP_NAME=BookIt System

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=bookit_db

# JWT
# Generar una clave propia con openssl rand -hex 32 antes de iniciar.
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:4200

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password